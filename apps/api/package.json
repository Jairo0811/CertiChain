{
  "name": "@certichain/api",
  "version": "0.2.0",
  "private": true,
  "description": "CertiChain application API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
