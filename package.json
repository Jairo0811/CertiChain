{
  "name": "certichain",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma para emisión, protección, compartición y verificación de certificados académicos mediante blockchain.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "blockchain"
  ],
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
