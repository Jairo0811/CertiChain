# API
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:8080
# Local development. In production set the real HTTPS route, e.g. https://certichain.example/verify
PUBLIC_VERIFY_URL=http://localhost:8080/verify
CERTICHAIN_DATA_FILE=.data/certichain.json

# Authentication (development bootstrap only)
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@certichain.local
ADMIN_PASSWORD=replace-with-a-strong-password

# PostgreSQL
POSTGRES_DB=certichain
POSTGRES_USER=certichain
POSTGRES_PASSWORD=certichain-local
DATABASE_URL=postgresql://certichain:certichain-local@db:5432/certichain

# Blockchain
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_RPC_URL=
SEPOLIA_RPC_URL=
POLYGON_AMOY_RPC_URL=
POLYGON_RPC_URL=
CHAIN_ID=11155111
CERTIFICATE_REGISTRY_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=

# Encrypted document storage
STORAGE_DRIVER=local
# 64 hexadecimal characters (32 bytes). Required in production.
DOCUMENT_ENCRYPTION_KEY=
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
IPFS_API_URL=
IPFS_API_TOKEN=

# Observability
METRICS_TOKEN=

# Web
VITE_API_URL=http://localhost:4000

# Mobile
MOBILE_APP_SCHEME=certichain
# PC local / simulador web: localhost puede ser válido.
# Teléfono físico: usa una IP LAN alcanzable desde el teléfono, por ejemplo http://192.168.1.50:4000
# Android Emulator: usa http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Ruta usada al compartir o generar QR móviles.
# Teléfono físico: por ejemplo http://192.168.1.50:8080/verify
# Android Emulator: por ejemplo http://10.0.2.2:8080/verify
# Producción futura: HTTPS real; no se define ningún dominio de producción en este repositorio.
EXPO_PUBLIC_VERIFY_URL=http://localhost:8080/verify
