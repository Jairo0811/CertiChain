{
  "expo": {
    "name": "CertiChain",
    "slug": "certichain",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "certichain",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/branding/certichain-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#050817"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a CertiChain usar la cámara para escanear códigos QR de certificados.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "android": {
      "package": "com.jairomatias.certichain",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070B1F"
      }
    },
    "ios": {
      "bundleIdentifier": "com.jairomatias.certichain"
    },
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
