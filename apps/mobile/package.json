{
  "name": "@certichain/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "CertiChain student mobile application",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform android --output-dir dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "expo": "^57.0.0",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.19",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  }
}
